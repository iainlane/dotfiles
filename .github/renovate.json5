{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeDigest",
    ":automergeBranch",
  ],
  timezone: "Europe/London",
  schedule: ["before 6am"],
  labels: ["dependencies"],
  commitMessagePrefix: "chore(deps): ",
  commitMessageAction: "update",
  commitMessageTopic: "{{depName}}",
  commitMessageExtra: "to {{#if isMajor}}v{{{newMajor}}}{{else}}{{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}}",
  separateMinorPatch: true,
  prHourlyLimit: 4,
  prConcurrentLimit: 10,
  branchConcurrentLimit: 20,

  // The nix manager is left out because flake.lock needs the private `secrets`
  // input, which Renovate cannot fetch. Bundler is left out because Renovate
  // cannot regenerate the gemset.nix that pkgs/trmnl-liquid-cli builds from.
  enabledManagers: ["github-actions", "pep621", "npm", "custom.regex"],

  "github-actions": {
    enabled: true,
    pinDigests: true,
  },

  packageRules: [
    {
      groupName: "all non-major dependencies",
      groupSlug: "all-minor-patch",
      matchManagers: ["github-actions", "pep621", "custom.regex"],
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },

    // Renovate's own pnpm relock cannot reach the local npm packages that the
    // lockfiles install from `.nix-providers`, and it cannot refresh the Nix
    // dependency hashes. The post-upgrade script runs the package updaters,
    // which do both.
    {
      matchManagers: ["npm"],
      rangeStrategy: "bump",
      skipArtifactsUpdate: true,
      postUpgradeTasks: {
        commands: ["bash .github/renovate-post-upgrade.bash"],
        executionMode: "branch",
        fileFilters: ["pkgs/**"],
      },
    },

    // Renovate's lock-file maintenance changes files only through the relock
    // that `skipArtifactsUpdate` turns off. The package-update workflow
    // maintains the pnpm lockfiles instead.
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["lockFileMaintenance"],
      enabled: false,
    },

    // The organisation's configuration groups every minor and patch update,
    // and the packages of each known monorepo, into shared branches. A failed
    // relock of one npm update would block the other updates in its branch,
    // so each npm dependency gets a branch of its own unless one of the groups
    // below includes it.
    {
      matchManagers: ["npm"],
      groupName: null,
    },

    {
      matchManagers: ["npm"],
      matchPackageNames: ["@logtape/**"],
      groupName: "LogTape",
    },

    {
      matchManagers: ["npm"],
      matchPackageNames: [
        "typescript",
        "@types/node",
        "oxlint",
        "oxlint-tsgolint",
        "syncpack",
      ],
      groupName: "TypeScript toolchain",
    },

    {
      matchManagers: ["npm"],
      matchPackageNames: ["vitest", "@vitest/**", "vite"],
      groupName: "Vitest and Vite",
    },

    // The package updaters set these to the versions of the local npm
    // packages, so a Renovate bump would be reverted or would fail.
    {
      matchManagers: ["npm"],
      matchPackageNames: [
        "@earendil-works/**",
        "@juicesharp/rpiv-btw",
        "@marckrenn/pi-sub-core",
        "@mariozechner/pi-coding-agent",
        "pi-prs",
        "pi-subagents",
        "typebox",
      ],
      enabled: false,
    },

    // Nix provides pnpm and Node.js. `@types/node` follows the major version of
    // Nix's Node.js.
    {
      matchManagers: ["npm"],
      matchDepTypes: ["packageManager"],
      enabled: false,
    },

    {
      matchManagers: ["npm"],
      matchPackageNames: ["@types/node"],
      allowedVersions: "<25",
    },

    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
      schedule: ["at any time"],
      automerge: false,
    },

    // cupboard only ships prerelease 0.x tags for now. Without this, Renovate
    // treats them as unstable and never proposes an update. Keep the reusable
    // workflow on a tag because its job_workflow_ref is matched by the tenant's
    // refs/tags/v* trust policy.
    {
      matchPackageNames: ["underwhelmingperformance/cupboard"],
      ignoreUnstable: false,
      pinDigests: false,
    },

    // `.github/workflows/cupboard.yml` calls this repository's own publish
    // wrapper at `@main`, and the laney tenant's trust policy matches its
    // `job_workflow_ref` on `refs/heads/main`. Pinning that reference to a
    // commit would stop it matching the policy, and Renovate would propose a
    // digest update after every push to main.
    {
      matchPackageNames: ["iainlane/dotfiles"],
      pinDigests: false,
    },
  ],

  customManagers: [
    {
      customType: "regex",
      description: "Update versions in YAML and Nix files using renovate comments",
      managerFilePatterns: ["/\\.ya?ml$/", "/\\.nix$/"],
      matchStrings: [
        // YAML writes `key: value` and Nix writes `key = "value";`, so the
        // pattern allows space around the separator and ends the value at the
        // closing quote or semicolon. A trailing `@sha256:...` is captured as
        // the digest, so a pinned image is updated in one piece.
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+[A-Za-z0-9_-]+?\\s*[:=]\\s*[\"']?(?<currentValue>[^\"';]+?)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?[\"']?;?\\s*$",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],

  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security"],
    rangeStrategy: "bump",
  },

  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: ["before 6am on Monday"],
  },
}
