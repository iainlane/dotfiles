{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeDigest",
    ":automergeBranch",
  ],
  timezone: "Europe/London",
  schedule: ["before 6am"],
  labels: ["dependencies"],
  commitMessagePrefix: "chore(deps): ",
  commitMessageAction: "update",
  commitMessageTopic: "{{depName}}",
  commitMessageExtra: "to {{#if isMajor}}v{{{newMajor}}}{{else}}{{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}}",
  separateMinorPatch: true,
  prHourlyLimit: 4,
  prConcurrentLimit: 10,
  branchConcurrentLimit: 20,

  "github-actions": {
    enabled: true,
    pinDigests: true,
  },

  packageRules: [
    {
      groupName: "all non-major dependencies",
      groupSlug: "all-minor-patch",
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },

    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
      schedule: ["at any time"],
      automerge: false,
    },

    // cupboard only ships prerelease 0.x tags for now. Without this, Renovate
    // treats them as unstable and never proposes an update. Keep the reusable
    // workflow on a tag because its job_workflow_ref is matched by the tenant's
    // refs/tags/v* trust policy.
    {
      matchPackageNames: ["underwhelmingperformance/cupboard"],
      ignoreUnstable: false,
      pinDigests: false,
    },

    // `.github/workflows/cupboard.yml` calls this repository's own publish
    // wrapper at `@main`, and the laney tenant's trust policy matches its
    // `job_workflow_ref` on `refs/heads/main`. Pinning that reference to a
    // commit would stop it matching the policy, and Renovate would propose a
    // digest update after every push to main.
    {
      matchPackageNames: ["iainlane/dotfiles"],
      pinDigests: false,
    },
  ],

  customManagers: [
    {
      customType: "regex",
      description: "Update versions in YAML and Nix files using renovate comments",
      managerFilePatterns: ["/\\.ya?ml$/", "/\\.nix$/"],
      matchStrings: [
        // YAML writes `key: value` and Nix writes `key = "value";`, so the
        // pattern allows space around the separator and ends the value at the
        // closing quote or semicolon. A trailing `@sha256:...` is captured as
        // the digest, so a pinned image is updated in one piece.
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+[A-Za-z0-9_-]+?\\s*[:=]\\s*[\"']?(?<currentValue>[^\"';]+?)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?[\"']?;?\\s*$",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],

  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security"],
  },

  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: ["before 6am on Monday"],
  },
}
