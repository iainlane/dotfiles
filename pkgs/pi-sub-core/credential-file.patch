+function loadClaudeFileToken(deps: Dependencies): string | undefined {
+	try {
+		const configDir = deps.env.CLAUDE_CONFIG_DIR || path.join(deps.homedir(), ".claude");
+		const contents = deps.readFile(path.join(configDir, ".credentials.json"));
+		if (!contents) return undefined;
+		const value: unknown = JSON.parse(contents);
+		if (typeof value !== "object" || value === null || !("claudeAiOauth" in value)) return undefined;
+		const oauth = value.claudeAiOauth;
+		if (typeof oauth !== "object" || oauth === null || !("accessToken" in oauth) || !("scopes" in oauth)) return undefined;
+		if (typeof oauth.accessToken !== "string" || !Array.isArray(oauth.scopes) || !oauth.scopes.includes("user:profile")) return undefined;
+		if (!("expiresAt" in oauth) || typeof oauth.expiresAt !== "number" || !Number.isFinite(oauth.expiresAt) || Date.now() >= oauth.expiresAt) return undefined;
+		return oauth.accessToken.trim() || undefined;
+	} catch {
+		return undefined;
+	}
+}
