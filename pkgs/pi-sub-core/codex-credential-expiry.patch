@@ -0,0 +1,58 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { CodexProvider } from "../src/providers/impl/codex.js";
+import { createDeps, getAuthPath } from "./helpers.js";
+
+for (const scenario of ["same-account", "different-account", "expired", "opaque"] as const) {
+	test(`codex handles expired Pi OAuth with fallback scenario ${scenario}`, async () => {
+		const token = scenario === "opaque"
+			? "opaque-token"
+			: `header.${Buffer.from(JSON.stringify({ exp: scenario === "expired" ? 1 : 4_102_444_800 })).toString("base64url")}.signature`;
+		const requests: { url: string; authorization: string | null; account: string | null }[] = [];
+		const { deps, files } = createDeps({
+			env: { CODEX_HOME: "/fixture/codex" },
+			fetch: async (url, init) => {
+				const headers = new Headers(init?.headers);
+				requests.push({ url: String(url), authorization: headers.get("Authorization"), account: headers.get("ChatGPT-Account-Id") });
+				return Response.json({});
+			},
+		});
+		files.set(getAuthPath(deps.homedir()), JSON.stringify({
+			"openai-codex": { type: "oauth", access: "expired-pi-token", accountId: "acct", expires: 1 },
+		}));
+		files.set("/fixture/codex/auth.json", JSON.stringify({
+			tokens: { access_token: token, account_id: scenario === "different-account" ? "other" : "acct" },
+		}));
+
+		const provider = new CodexProvider();
+		assert.equal(provider.hasCredentials(deps), true);
+		assert.deepEqual(
+			await provider.fetchUsage(deps),
+			scenario === "same-account"
+				? { provider: "codex", displayName: "Codex Plan", windows: [], accountId: "acct", credentialSource: "codex", skippedExpiredCredential: "pi" }
+				: {
+					provider: "codex", displayName: "Codex Plan", windows: [],
+					error: { code: "API_ERROR", message: "Quota credential expired", httpStatus: undefined, credential: { source: "pi", expired: true } },
+				},
+		);
+		assert.deepEqual(requests, scenario === "same-account"
+			? [{ url: "https://chatgpt.com/backend-api/wham/usage", authorization: `Bearer ${token}`, account: "acct" }]
+			: []);
+	});
+}
+
+for (const code of ["token_expired", "unauthorized"]) {
+	test(`codex classifies a 401 with code ${code}`, async () => {
+		const { deps } = createDeps({
+			env: { OPENAI_CODEX_OAUTH_TOKEN: "override" },
+			fetch: async () => Response.json({ error: { code } }, { status: 401 }),
+		});
+		assert.deepEqual(await new CodexProvider().fetchUsage(deps), {
+			provider: "codex", displayName: "Codex Plan", windows: [],
+			error: {
+				code: "HTTP_ERROR", message: "HTTP 401", httpStatus: 401,
+				credential: code === "token_expired" ? { source: "environment", expired: true } : { source: "environment" },
+			},
+		});
+	});
+}
