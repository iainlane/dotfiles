StylesPath = @stylesPath@
MinAlertLevel = suggestion

# Vale has no parser for the first group and would otherwise skip the files.
# Perl has the same line comment marker, so mapping to it leaves the comments
# to lint when Vale is run directly; prose-lint extracts those comments itself
# and reads them as Markdown, which the part-of-speech rules need.
#
# The second group are languages Vale parses. Mapping each to Markdown makes
# Vale read the extracted comments as Markdown too, so code spans are skipped
# and the part-of-speech rules run. Lua and PHP reject Markdown mappings.
# Vale can lint their comments without the mapping; prose-lint extracts PHP
# comments so its Markdown rules also run.
[formats]
bash = pl
cfg = pl
conf = pl
ini = pl
nix = pl
sh = pl
toml = pl
yaml = pl
yml = pl
c = md
cc = md
cpp = md
cs = md
go = md
h = md
hpp = md
java = md
js = md
jsx = md
py = md
r = md
rb = md
rs = md
scala = md
swift = md
ts = md
tsx = md

# prose-lint passes a commit message on standard input with `--ext=.commit`.
# Reading it as Markdown skips the identifiers that a message writes as code
# spans.
commit = md

[*]
BasedOnStyles = Prose
Prose.AmericanSpelling = NO
Prose.BoldLabelBullets = NO
Prose.Chronology = NO
Prose.DiffWalkthrough = NO
Prose.PrTalk = NO
Prose.ReviewRationale = NO
Prose.Trailers = NO

[*.{commit,txt}]
Prose.Chronology = warning
Prose.DiffWalkthrough = warning
Prose.PrTalk = warning
Prose.Trailers = error

[*.{bash,c,cc,cfg,conf,cpp,cs,go,h,hpp,ini,java,js,jsx,lua,nix,php,pl,py,r,rb,rs,scala,sh,swift,toml,ts,tsx,yaml,yml}]
Prose.ReviewRationale = error

[*.md]
Prose.BoldLabelBullets = warning
BlockIgnores = (?s) *(```text\nBAD:.*?```)

# Identifier-shaped tokens are not prose, so every rule skips them: a
# hyphenated name with a capitalised part after the first, such as
# `SPDX-License-Identifier` or `Content-Type`; a dotted name of lowercase parts
# with two or more characters each, such as `kern.argmax`; and a long option
# such as `--color`. Ordinary hyphenated compounds are lowercase after the
# first part, so the rules still read them, but a Title Case compound, as in a
# heading, is skipped too. The two-character parts keep `e.g.` visible to the
# Latin rule.
#
# Vale separates the patterns with commas, so none of them contains one.
#
# The section lists the markup formats and the code formats whose comments
# Vale or prose-lint reads as Markdown. Lua is left out: Vale reads its
# comments as plain lines, where TokenIgnores has no effect. Commit messages
# are Markdown as well but are left out too, because the first pattern would
# hide `Co-Authored-By:` from the trailer rule.
[*.{adoc,markdown,md,org,rst,bash,c,cc,cfg,conf,cpp,cs,go,h,hpp,ini,java,js,jsx,nix,php,pl,py,r,rb,rs,scala,sh,swift,toml,ts,tsx,yaml,yml}]
TokenIgnores = \b[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*-[A-Z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*\b, \b[a-z][a-z0-9_]+(?:\.[a-z0-9_][a-z0-9_]+)+\b, \B--[A-Za-z][A-Za-z0-9-]*
