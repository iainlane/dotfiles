+}
+
+type FileToolRenderContext = ToolRenderContext<Record<string, unknown>, unknown>;
+
+function isToolArgs(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Styles file-tool rows through the native renderer registry. */
+export function registerClaudeFileToolRenderers(pi: Pick<ExtensionAPI, "registerToolRenderer">, enabled: boolean): void {
+	for (const tool of ["write", "edit"]) {
+		if (enabled) styledToolNames.add(tool);
+		else styledToolNames.delete(tool);
+	}
+	if (!enabled) return;
+	pi.registerToolRenderer((toolName, next) => {
+		const delegated = next();
+		if (toolName !== "write" && toolName !== "edit") return delegated;
+		const nativeCall = delegated?.renderCall;
+		const nativeResult = delegated?.renderResult;
+		if (nativeCall === undefined || nativeResult === undefined) return delegated;
+		const label = toolName === "write" ? "Write" : "Edit";
+		const styled = claudeRenderers(toolName, label);
+		const states = new WeakMap<object, FileToolRenderState>();
+		const stateFor = (context: FileToolRenderContext): FileToolRenderState => {
+			const previous = states.get(context.state);
+			if (previous) return previous;
+			const state = { call: new Container(), result: new Container() };
+			states.set(context.state, state);
+			return state;
+		};
+		return {
+			...delegated,
+			renderShell: "self",
+			renderCall(args: unknown, theme, context: FileToolRenderContext) {
+				const state = stateFor(context);
+				const display = { ...context, callLabel: context.callLabel ?? label };
+				state.nativeCall = nativeCall(args, theme, { ...display, lastComponent: state.nativeCall });
+				state.call.clear();
+				state.call.addChild(context.expanded
+					? state.nativeCall
+					: styled.renderCall(isToolArgs(args) ? args : {}, theme, { ...display, args: isToolArgs(context.args) ? context.args : {}, lastComponent: undefined }));
+				return state.call;
+			},
+			renderResult(result, options, theme, context: FileToolRenderContext) {
+				const state = stateFor(context);
+				const display = { ...context, callLabel: context.callLabel ?? label };
+				state.nativeResult = nativeResult(result, options, theme, { ...display, lastComponent: state.nativeResult });
+				state.result.clear();
+				state.result.addChild(context.expanded
+					? state.nativeResult
+					: styled.renderResult(result, options, theme, { ...display, args: isToolArgs(context.args) ? context.args : {}, lastComponent: undefined }));
+				return state.result;
+			},
+		};
+	});
+}
+
+const EXTERNAL_TOOLS = ["apply_patch", "codemode", "recall"];
