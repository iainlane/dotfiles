{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "#footer/*": ["./src/*"],
      "#test/*": ["./test/*"],
      "#demo/*": ["./demo/*"],
      "#scripts/*": ["./scripts/*"],
      "#fixtures/*": ["./.fixtures/*"],
      "#footer-entry": ["./index.ts"]
    }
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "demo/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
