{
  "name": "@dotfiles/pi-session-footer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "imports": {
    "#footer/*": "./src/*",
    "#test/*": "./test/*",
    "#demo/*": "./demo/*",
    "#scripts/*": "./scripts/*",
    "#fixtures/*": "./.fixtures/*",
    "#footer-entry": "./index.ts"
  },
  "scripts": {
    "test": "node scripts/prepare-fixtures.ts && vitest run",
    "typecheck": "tsc -p tsconfig.source.json && tsc -p tsconfig.json",
    "lint": "oxlint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/prepare-fixtures.ts && vitest run --project integration"
  },
  "dependencies": {
    "pi-prs": "0.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@homebridge/node-pty-prebuilt-multiarch": "0.15.0",
    "@juicesharp/rpiv-btw": "2.15.0",
    "@marckrenn/pi-sub-core": "1.5.0",
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@1.5.2",
    "@types/node": "24.19.2",
    "@xterm/headless": "6.0.0",
    "msw": "2.15.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "files": [
    "index.ts",
    "src"
  ],
  "peerDependencies": {
    "typebox": "1.3.27"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  }
}
