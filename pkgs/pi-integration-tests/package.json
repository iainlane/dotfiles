{
  "name": "@dotfiles/pi-integration-tests",
  "version": "0.1.0",
  "scripts": {
    "typecheck": "node ../../lib/typecheck.ts --noEmit",
    "lint": "oxlint . && syncpack lint --config ../../.syncpackrc.json",
    "check": "pnpm typecheck && pnpm lint && node --test dist/rpc-session.test.js",
    "build": "tsc"
  },
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "!dist/*.test.js",
    "!dist/*.test.d.ts"
  ],
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-coding-agent": "^1.6.1",
    "@earendil-works/pi-tui": "1.6.1",
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2008",
    "syncpack": "^15.3.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "packageManager": "pnpm@10.34.7",
  "exports": {
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./rpc-session": {
      "types": "./dist/rpc-session.d.ts",
      "default": "./dist/rpc-session.js"
    }
  }
}
