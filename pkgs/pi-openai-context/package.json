{
  "name": "@dotfiles/pi-openai-context",
  "version": "0.1.0",
  "description": "Apply ChatGPT account context windows to OpenAI models in Pi",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "imports": {
    "#openai-context/*": "./src/*"
  },
  "scripts": {
    "typecheck": "node ../../lib/typecheck.ts --noEmit",
    "lint": "oxlint . && syncpack lint --config ../../.syncpackrc.json",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "files": [
    "index.ts",
    "src"
  ],
  "devDependencies": {
    "@dotfiles/pi-integration-tests": "^0.1.0",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-coding-agent": "^1.6.1",
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "syncpack": "^15.3.3",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "typebox": "1.3.27"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  }
}
