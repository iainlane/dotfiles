{
  "name": "@dotfiles/pi-openai-context",
  "version": "0.1.0",
  "description": "Apply ChatGPT account context windows to OpenAI models in Pi",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "imports": {
    "#openai-context/*": "./src/*"
  },
  "scripts": {
    "typecheck": "node ../../lib/typecheck.ts --noEmit",
    "lint": "oxlint . && syncpack lint --config ../../.syncpackrc.json",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "files": [
    "index.ts",
    "src"
  ],
  "devDependencies": {
    "@dotfiles/pi-integration-tests": "^0.1.0",
    "@earendil-works/pi-ai": "1.7.0",
    "@earendil-works/pi-coding-agent": "^1.7.0",
    "@types/node": "^24.19.2",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "syncpack": "^15.3.4",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "typebox": "1.3.27"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  }
}
