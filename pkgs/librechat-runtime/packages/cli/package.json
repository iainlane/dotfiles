{
  "name": "@dotfiles/librechat-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "librechat-runtime": "dist/bin/librechat-runtime.js",
    "librechatctl": "dist/bin/librechatctl.js"
  },
  "imports": {
    "#cli/*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.declarations.json"
  },
  "dependencies": {
    "@bomb.sh/router": "^0.8.0",
    "@clack/prompts": "^1.8.1",
    "@dotfiles/librechat-runtime": "workspace:*",
    "zod": "catalog:"
  }
}
