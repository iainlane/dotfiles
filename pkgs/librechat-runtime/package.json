{
  "name": "@dotfiles/librechat-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "prepare:code-bridge": "node scripts/prepare-code-bridge.ts",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "oxlint packages scripts vitest.config.ts",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "recheck": "^4.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
